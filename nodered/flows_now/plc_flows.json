    {
        "id": "210ac071d45508dc",
        "type": "function",
        "z": "887d9079ebe7f11b",
        "name": "Function 1 | 5개 데이터만 변환",
        "func": "\nconst data = Array.isArray(msg.payload)\n    ? msg.payload\n    : msg.payload?.data;\n\nif (!Array.isArray(data) || data.length < 4) {\n    node.warn(\"Modbus 4개 데이터 형식 오류\");\n    return null;\n}\n\n// Modbus 데이터\nconst current = Number(data[0]);\nconst frequency = Number(data[1]);\nconst voltage = Number(data[2]);\nconst dcVoltage = Number(data[3]);\n\n// Function 2에서 저장한 RPM 가져오기\nconst saved = global.get(\"inverterRPM\");\n\nconst rpmOK = saved &&\n    Number.isFinite(Number(saved.value)) &&\n    Date.now() - saved.time < 5000;\n\nconst rpm = rpmOK ? Number(saved.value) : null;\n\n// 실제 단위로 변환\nconst display = {\n    outputCurrent: current / 10,\n    outputFrequency: frequency / 100,\n    outputVoltage: voltage / 10,\n    dcLinkVoltage: dcVoltage / 10,\n    outputRpm: rpm\n};\n\n// 출력 1은 항상 Debug로 보냄\nconst displayMsg = { payload: display };\n\n// RPM이 없으면 PLC 전송은 잠시 중단\nif (!rpmOK) {\n    node.status({\n        fill: \"yellow\",\n        shape: \"ring\",\n        text: \"RPM 데이터 대기 중\"\n    });\n    return [displayMsg, null];\n}\n\n// PLC 전송용 원시값 5개\nconst values = [\n    current,\n    frequency,\n    voltage,\n    dcVoltage,\n    rpm\n];\n\nif (values.some(v =>\n    !Number.isInteger(v) || v < 0 || v > 65535\n)) {\n    node.warn(\"PLC 전송값 오류\");\n    return [displayMsg, null];\n}\n\nnode.status({\n    fill: \"green\",\n    shape: \"dot\",\n    text: \"5개 데이터 정상\"\n});\n\nreturn [\n    displayMsg,\n    { payload: values }\n];\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 520,
        "y": 180,
        "wires": [
            [
                "c07bf188df935a2c"
            ],
            [
                "dcaf4499611e0f24",
                "48d80b7aa759c507"
            ]
        ]
