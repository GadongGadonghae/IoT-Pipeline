    {
        "id": "d749a6c743de409e",
        "type": "function",
        "z": "887d9079ebe7f11b",
        "name": "16초 평균 → A-SL 측정값",
        "func": "// 인버터 값(1초마다) 16개를 모아 평균 → 제품 1개 = 1건 (sfaas/raw/A-SL), 제품 번호를 붙여요\n// 1초마다 읽는 이유: 16초 간격이면 인버터 서버PC가 연결을 끊음\nconst d = Array.isArray(msg.payload) ? msg.payload : msg.payload?.data;\nif (!Array.isArray(d) || d.length < 4) { node.warn('인버터 데이터 형식 오류'); return null; }\n\n// 단위 변환 (PLC 담당 flow와 같은 규칙) — 그래서 우리 Node-RED 정제 3번은 필요 없어요\nconst current = Number(d[0]) / 10;    // A\nconst freq    = Number(d[1]) / 100;   // Hz (확인용, DB에는 안 들어감)\nconst voltage = Number(d[2]) / 10;    // V\nif (![current, freq, voltage].every(Number.isFinite)) { node.warn('숫자 아님'); return null; }\n\nflow.set('lastOk', Date.now());       // 상태 신호용: 마지막으로 잘 읽은 시각\n\nconst N = 16;                         // 슬리팅 처리 시간 16초 = 제품 1개\nconst buf = context.get('buf') || [];\nbuf.push({ current, voltage });\nnode.status({ fill: 'green', shape: 'dot', text: `${current}A · ${voltage}V · ${freq}Hz (${buf.length}/${N})` });\nif (buf.length < N) { context.set('buf', buf); return null; }\ncontext.set('buf', []);\n\nconst avg = (k) => Math.round(buf.reduce((s, x) => s + x[k], 0) / buf.length * 100) / 100;\nglobal.set('aslAvg', { current: avg('current'), voltage: avg('voltage'), at: Date.now() });   // ★ 임시: B~F 복사용 16초 평균\n// 제품 번호 (v0.3.8): 슬리팅 투입 때 생김 → A-YYYYMMDD-0001부터 차례로. 날짜가 바뀌거나 [제품 번호 초기화]를 누르면 0001부터\nconst day = new Date(Date.now() + 9 * 3600 * 1000).toISOString().slice(0, 10).replace(/-/g, '');\nlet seq = flow.get('pidSeq');\nif (!seq || seq.day !== day) seq = { day, n: 0 };\nseq.n += 1;\nflow.set('pidSeq', seq);\nglobal.set('aslLatest', { current, voltage, at: Date.now() });   // ★ 임시: B~F 슬리팅에 복사할 값\nconst productId = `A-${day}-${String(seq.n).padStart(4, '0')}`;\n\nmsg.topic = 'sfaas/raw/A-SL';\nmsg.payload = {\n    equipmentId: 'A-SL',\n    ts: new Date().toISOString(),\n    source: 'PLC',\n    productId,\n    values: { current: avg('current'), voltage: avg('voltage') }   // torque: 읽을 주소를 찾으면 여기에 추가\n};\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 470,
        "y": 100,
