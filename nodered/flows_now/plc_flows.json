    {
        "id": "fde53822b88bf426",
        "type": "function",
        "z": "887d9079ebe7f11b",
        "name": "Function 2 | RPM 최신값 저장",
        "func": "\nconst p = msg.payload;\n\nconst data = Array.isArray(p)\n    ? p\n    : p?.data;\n\nif (!Array.isArray(data) || data.length === 0) {\n    node.warn(\"RPM 데이터 형식 오류: \" + JSON.stringify(p));\n    return null;\n}\n\nconst rpm = Number(data[0]);\n\nif (!Number.isFinite(rpm) || rpm < 0) {\n    node.warn(\"RPM 값 오류: \" + rpm);\n    return null;\n}\n\n// 최신 RPM 저장 (Function 1과 공유)\nglobal.set(\"inverterRPM\", {\n    value: rpm,\n    time: Date.now()\n});\n\n// 노드 아래에 RPM 표시\nnode.status({\n    fill: \"green\",\n    shape: \"dot\",\n    text: \"RPM: \" + rpm\n});\n\n// Debug로 RPM 출력\nmsg.payload = {\n    outputRpm: rpm\n};\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
