    {
        "id": "7f1249bc886d2984",
        "type": "function",
        "z": "887d9079ebe7f11b",
        "name": "상태 신호 (fault=false)",
        "func": "// 1초마다 상태 신호. 고장은 안 읽으므로 fault는 항상 false\n// ---------------- [코드 B] \"상태 신호 (fault=false)\" 맨 위에 추가 ----------------\n// player가 재생 중일 때만 보내요 (재생이 끝나면 다른 설비처럼 DC가 되게)\nif (!flow.get('replayRunning')) {\n    node.status({ fill: 'grey', shape: 'ring', text: '재생 안 함 → 신호 멈춤' });\n    return null;\n}\n\n// 20초 넘게 인버터를 못 읽었으면 보내지 않음 → 백엔드에서 DC(통신 끊김)로 보임\nconst last = flow.get('lastOk') || 0;\nif (Date.now() - last > 20000) {\n    node.status({ fill: 'red', shape: 'ring', text: '인버터 응답 없음 → 신호 멈춤' });\n    return null;\n}\nnode.status({ fill: 'green', shape: 'dot', text: '신호 보내는 중' });\nmsg.topic = 'sfaas/hb/A-SL';\nmsg.payload = { equipmentId: 'A-SL', ts: new Date().toISOString(), fault: false };\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
